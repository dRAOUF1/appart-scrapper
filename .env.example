# Copier en .env et renseigner les valeurs. Ne jamais committer le .env réel.

# Requis — connexion PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/appart

# Requis — clé de signature des sessions Flask (aucune valeur par défaut,
# l'app refuse de démarrer sans elle). Générer avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Requis pour accéder à /admin — doit correspondre au username d'un compte
# existant. Sans cette variable, aucun accès admin n'est possible (fail-closed).
ADMIN_USERNAME=

# Optionnel — port d'écoute (défaut 10000)
PORT=10000
