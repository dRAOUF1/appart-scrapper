# ---- Test image — not used in production, only by docker-compose.test.yml ----
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

# Arbre complet, tests/ inclus — contrairement au Dockerfile de production, qui
# liste ses COPY fichier par fichier et exclut délibérément les tests.
#
# docker-compose.test.yml monte ensuite le répertoire courant sur /app, ce qui
# recouvre cette copie : elle sert à ce que l'image reste utilisable seule
# (`docker run` sans volume), pas au chemin compose.
COPY . .

CMD ["pytest", "tests/", "-v", "--tb=short"]
